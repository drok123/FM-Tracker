--- a/firmware/src/project.c
+++ b/firmware/src/project.c
@@ -550,8 +550,45 @@ static void proj_apply(const project_t *p, int all)
             }
         fm6_track_loaded(t);                            /* FM6: the project keeps PTCH, not the patch: its slot's */
     }
+#if FELUCCA_TRACKER
+    fm_tracker_sloop_reapply_active(); /* scene snapshots stay whole-project; active phrases remain separate */
+#endif
 }
 
+#if FELUCCA_TRACKER
+/* Copy one track's pattern data from a whole-project scene into the separate
+ * FM-Tracker bank. This never edits the scene or applies any other track. */
+int fm_tracker_phrase_import_scene(uint8_t track, uint8_t phrase, uint8_t scene)
+{
+    const project_t *p;
+    const proj_trk_t *s;
+    int8_t micro[NSTEP];
+    uint8_t fill[NSTEP / 4u];
+    uint32_t i;
+    int32_t length, division;
+    if (track >= NTRK || phrase >= FM_TRACKER_PHRASES || scene >= 4u)
+        return 0;
+    p = &proj_slot[scene];
+    if (!proj_ok(p))
+        return 0;
+    s = &p->t[track];
+    memset(fill, 0, sizeof fill);
+    for (i = 0; i < NSTEP; i++) {
+        uint32_t condition = pt_fill(s, i);
+        micro[i] = (int8_t)clamp(pt_micro(s, i), MICRO_MIN, MICRO_MAX);
+        if (condition != 3u)
+            fill[i / 4u] |= (uint8_t)(condition << (2u * (i % 4u)));
+    }
+    length = clamp(pt_get(s, P_SLEN), 1, NSTEP);
+    division = clamp(pt_get(s, P_SDIV), 0, NDIV_STEP - 1u);
+    return fm_tracker_phrase_store(track, phrase, s->step, micro, fill,
+                                   s->lock, (int16_t)length,
+                                   (int16_t)division,
+                                   (int16_t)clamp(pt_get(s, P_SSWING), 0, 100),
+                                   (int16_t)clamp(pt_get(s, P_SGATE), 1, 127));
+}
+#endif
+
