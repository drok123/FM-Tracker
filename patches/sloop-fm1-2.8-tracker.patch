diff --git a/firmware/src/fm_tracker_bank.c b/firmware/src/fm_tracker_bank.c
new file mode 100644
index 0000000..35d5cee
--- /dev/null
+++ b/firmware/src/fm_tracker_bank.c
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "fm_tracker_bank.h"
+
+fm_tracker_phrase_t fm_tracker_phrase_bank[NTRK][FM_TRACKER_PHRASES];
+uint8_t fm_tracker_phrase_valid[NTRK];
+_Static_assert(sizeof fm_tracker_phrase_bank <= 13200u,
+               "the initial native phrase bank stays bounded to 13.2 KB");
+
+int fm_tracker_phrase_store(uint8_t track, uint8_t phrase,
+                            const step_t *steps, const int8_t *micro,
+                            const uint8_t *fill, const plock_t *locks,
+                            int16_t length, int16_t division,
+                            int16_t swing, int16_t gate)
+{
+    fm_tracker_phrase_t *dst;
+    uint32_t i;
+    if (track >= NTRK || phrase >= FM_TRACKER_PHRASES || steps == 0 ||
+        micro == 0 || fill == 0 || locks == 0 || length < 1 || length > NSTEP ||
+        division < 0 || division >= NDIV_STEP || swing < 0 || swing > 100 ||
+        gate < 1 || gate > 127)
+        return 0;
+    for (i = 0; i < NSTEP; i++) {
+        if (micro[i] < MICRO_MIN || micro[i] > MICRO_MAX)
+            return 0;
+        if (track != TRK_DRUM) {
+            uint32_t k, n = steps[i].n;
+            if (n > 4u || steps[i].time > ST_REST)
+                return 0;
+            for (k = 0; k < n; k++)
+                if (steps[i].note[k] > 127u)
+                    return 0;
+        }
+    }
+    dst = &fm_tracker_phrase_bank[track][phrase];
+    /* The audio callback reads one slot while selecting a chain entry. */
+    fm1_irq_off();
+    memcpy(dst->step, steps, sizeof dst->step);
+    memcpy(dst->micro, micro, sizeof dst->micro);
+    memcpy(dst->fill, fill, sizeof dst->fill);
+    memcpy(dst->lock, locks, sizeof dst->lock);
+    dst->length = length;
+    dst->division = division;
+    dst->swing = swing;
+    dst->gate = gate;
+    fm_tracker_phrase_valid[track] |= (uint8_t)(1u << phrase);
+    fm1_irq_on();
+    return 1;
+}
+
+int fm_tracker_phrase_capture(uint8_t track, uint8_t phrase)
+{
+    const track_t *src;
+    if (track >= NTRK)
+        return 0;
+    src = &trk[track];
+    return fm_tracker_phrase_store(track, phrase, src->step, src->micro,
+                                   src->fill, src->lock, src->p[P_SLEN],
+                                   src->p[P_SDIV], src->p[P_SSWING],
+                                   src->p[P_SGATE]);
+}
+
+int fm_tracker_phrase_present(uint8_t track, int16_t phrase)
+{
+    return track < NTRK && phrase >= 0 && phrase < (int16_t)FM_TRACKER_PHRASES &&
+           (fm_tracker_phrase_valid[track] & (uint8_t)(1u << phrase)) != 0u;
+}
diff --git a/firmware/src/fm_tracker_bank.h b/firmware/src/fm_tracker_bank.h
new file mode 100644
index 0000000..f044771
--- /dev/null
+++ b/firmware/src/fm_tracker_bank.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* FM-Tracker native phrase bank. Included only by the FM-Tracker SLOOP overlay. */
+#ifndef FM_TRACKER_BANK_H
+#define FM_TRACKER_BANK_H
+
+#include "tracker_chain.h"
+
+#define FM_TRACKER_PHRASES 4u
+
+typedef struct {
+    union {
+        step_t step[NSTEP];
+        dstep_t dstep[NSTEP];
+    };
+    int8_t micro[NSTEP];
+    uint8_t fill[NSTEP / 4u];
+    plock_t lock[NLOCK];
+    int16_t length;
+    int16_t division;
+    int16_t swing;
+    int16_t gate;
+} fm_tracker_phrase_t;
+
+/* One fixed-size bank per physical SLOOP track. The 64-entry chain can reuse
+ * these slots; project scenes remain separate whole-project snapshots. */
+extern fm_tracker_phrase_t fm_tracker_phrase_bank[NTRK][FM_TRACKER_PHRASES];
+extern uint8_t fm_tracker_phrase_valid[NTRK];
+
+int fm_tracker_phrase_store(uint8_t track, uint8_t phrase,
+                            const step_t *steps, const int8_t *micro,
+                            const uint8_t *fill, const plock_t *locks,
+                            int16_t length, int16_t division,
+                            int16_t swing, int16_t gate);
+int fm_tracker_phrase_capture(uint8_t track, uint8_t phrase);
+int fm_tracker_phrase_present(uint8_t track, int16_t phrase);
+int fm_tracker_phrase_import_scene(uint8_t track, uint8_t phrase, uint8_t scene);
+
+#endif
