index 7cb22cb..58f323a 100644
--- a/firmware/src/ui.c
+++ b/firmware/src/ui.c
@@ -98,6 +98,13 @@ static int32_t accel(uint32_t role, int32_t s, int32_t range);   /* ui_input.c *
 static void layer_screen_draw(void);                            /* ui_layers.c */
 static void hold_screen_draw(void);
 static uint8_t layer_shown;
