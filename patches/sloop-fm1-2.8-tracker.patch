diff --git a/firmware/src/ui_tracker.c b/firmware/src/ui_tracker.c
new file mode 100644
index 0000000..be7506c
--- /dev/null
+++ b/firmware/src/ui_tracker.c
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* A view/editor of the native phrase bank, never a second sequencer. */
+#if FELUCCA_TRACKER
+static struct {
+    uint8_t phrase, row, voice;
+    uint8_t dirty;                    /* screen invalidation, not sequencer state */
+} tracker_ui;
+
+UI_SMALL static int tracker_ui_active(void) { return tracker_editor_mode; }
+
+UI_SMALL static int tracker_ui_busy(void)
+{
+    return song.playing || transport_req || song.rec || rec_wait || ft_on || ci_on;
+}
+
+UI_SMALL static void tracker_ui_open(void)
+{
+    if (tracker_ui_busy())
+        return;
+    layer_unlock();
+    go_home();                        /* no hidden step-entry or grid keyboard */
+    vis_on = 0;
+    kb_grid = 0;
+    ui.menu = 0;
+    tracker_editor_mode = 1;
+    ui.layer = LY_PLAY;
+    lk_r = lk_w;
+    tracker_ui.dirty = 1;
+}
+
+UI_SMALL static fm_tracker_phrase_t *tracker_ui_phrase(void)
+{
+    return fm_tracker_phrase_present(song.sel, tracker_ui.phrase) ?
+        &fm_tracker_phrase_bank[song.sel][tracker_ui.phrase] : 0;
+}
+
+UI_SMALL static void tracker_ui_fix(void)
+{
+    fm_tracker_phrase_t *p = tracker_ui_phrase();
+    uint32_t len = p ? (uint32_t)clamp(p->length, 1, NSTEP) : NSTEP;
+    if (tracker_ui.row >= len)
+        tracker_ui.row = (uint8_t)(len - 1u);
+    if (tracker_ui.voice >= (is_drum(TSEL) ? DRUM_LANES : 4u))
+        tracker_ui.voice = 0;
+}
+
+/* All mutations are main-loop only, stopped, and atomic against audio/USB
+ * transport requests. No live-track change occurs until explicit LOAD. */
+UI_SMALL static void tracker_ui_edit(uint32_t knob, int32_t delta)
+{
+    fm_tracker_phrase_t *p;
+    step_t *st;
+    uint32_t v = tracker_ui.voice;
+    if (!delta || tracker_ui_busy() || !(p = tracker_ui_phrase()))
+        return;
+    fm1_irq_off();
+    if (tracker_ui_busy()) {
+        fm1_irq_on();
+        return;
+    }
+    st = &p->step[tracker_ui.row];
+    if (knob == 3u)
+        p->micro[tracker_ui.row] = (int8_t)clamp(p->micro[tracker_ui.row] + delta, MICRO_MIN, MICRO_MAX);
+    else if (!is_drum(TSEL)) {
+        if (knob == 0u && v == 0u && (st->time != ST_NOTE || !st->n)) {
+            step_clear(st);
+            st->time = ST_NOTE;
+            st->n = 1;
+            st->note[0] = 60;
+            st->vel = 96;
+        } else if (st->time == ST_NOTE && v < st->n && v < 4u) {
+            if (knob == 0u)
+                st->note[v] = (uint8_t)clamp(st->note[v] + delta, 0, 127);
+            if (knob == 1u)
+                st->vel = (uint8_t)clamp((st->vel ? st->vel : 96) + delta, 1, 127);
+        }
+    } else {
+        dstep_t *d = &p->dstep[tracker_ui.row];
+        uint8_t bit = (uint8_t)(1u << (v & 7u));
+        if (knob == 0u) {
+            if (delta > 0) d->on[v / 8u] |= bit;
+            else d->on[v / 8u] &= (uint8_t)~bit;
+        }
+        if (knob == 1u && (d->on[v / 8u] & bit)) {
+            uint32_t shift = 2u * (v % 4u);
+            uint32_t level = (d->lvl[v / 4u] >> shift) & 3u;
+            /* LV_* is stored NORM,GHOST,SOFT,HARD, not loudness order. */
+            static const uint8_t rank[4] = {2, 0, 1, 3}, value[4] = {LV_GHOST, LV_SOFT, LV_NORM, LV_HARD};
+            level = value[clamp((int32_t)rank[level] + delta, 0, 3)];
+            d->lvl[v / 4u] = (uint8_t)((d->lvl[v / 4u] & ~(3u << shift)) | (level << shift));
+        }
+    }
+    fm1_irq_on();
+    tracker_ui.dirty = 1;
+}
+
+UI_SMALL static void tracker_ui_input(uint32_t pressed, uint32_t home)
+{
+    uint32_t k;
+    int32_t s;
+    if (home == BT_TAP || home == BT_HOLD) {
+        tracker_editor_mode = 0;
+        lk_r = lk_w;
+        go_home();
+        /* A hold's release must not open the visualiser. */
+        if (home == BT_HOLD) home_eat = 1;
+        for (k = 0; k < NE; k++) panel_enc(k);
+        return;
+    }
+    if ((s = panel_enc(EN_ALGO)) != 0) {
+        track_select((uint32_t)clamp((int32_t)song.sel + s, 0, NTRK - 1));
+        tracker_ui.voice = 0;
+        tracker_ui.dirty = 1;
+    }
+    if ((s = panel_enc(EN_PRESET)) != 0) {
+        tracker_ui.phrase = (uint8_t)clamp(tracker_ui.phrase + s, 0, FM_TRACKER_PHRASES - 1);
+        tracker_ui.dirty = 1;
+    }
+    tracker_ui_fix();
+    if ((s = panel_enc(EN_SELECT)) != 0) {
+        fm_tracker_phrase_t *p = tracker_ui_phrase();
+        tracker_ui.row = (uint8_t)clamp(tracker_ui.row + s, 0, p ? p->length - 1 : NSTEP - 1);
+        tracker_ui.dirty = 1;
+    }
+    if ((s = panel_enc(EN_K3)) != 0) {
+        tracker_ui.voice = (uint8_t)clamp(tracker_ui.voice + s, 0, is_drum(TSEL) ? DRUM_LANES - 1 : 3);
+        tracker_ui.dirty = 1;
+    }
+    tracker_ui_edit(0, panel_enc(EN_K1));
+    tracker_ui_edit(1, panel_enc(EN_K2));
+    tracker_ui_edit(3, panel_enc(EN_K4));
+    if (!tracker_ui_busy()) {
+        if (pressed & (1u << panel.btn[B_SEQ])) {
+            /* Capture and apply use the same native bank and transition as chains. */
+            fm1_irq_off();
+            if (!tracker_ui_busy())
+                fm_tracker_phrase_capture(song.sel, tracker_ui.phrase);
+            fm1_irq_on();
+            tracker_ui.dirty = 1;
+        } else if ((pressed & (1u << panel.btn[B_OCTUP])) && tracker_ui_phrase()) {
+            fm1_irq_off();
+            if (!tracker_ui_busy())
+                tracker_phrase_transition(0, song.sel, -1, 0, tracker_ui.phrase, 0, 0);
+            fm1_irq_on();
+            tracker_ui.dirty = 1;
+        }
+    }
+    if (pressed & (1u << panel.btn[B_PLAY])) {
+        if (song.playing || !arrangement_enabled || arr_valid(&arrangement, arrangement_ready()))
+            if (!ft_owns_press()) transport_req = song.playing ? 2 : 1;
+    }
+    tracker_ui_fix();
+}
+
+UI_SMALL static void tracker_ui_draw(void)
+{
+    fm_tracker_phrase_t *p = tracker_ui_phrase();
+    uint32_t i, first, v = tracker_ui.voice, busy = tracker_ui_busy();
+    static uint32_t was_busy = 99;
+    char b[32];
+    tracker_ui_fix();
+    if (!ui.force && !tracker_ui.dirty && was_busy == busy)
+        return;
+    tracker_ui.dirty = 0;
+    was_busy = busy;
+    cv_begin(240, 20, C_BLACK);
+    str_cpy(b, "TRACKER T", sizeof b); fmt_int(b + 9, song.sel + 1);
+    str_cpy(b + str_len(b), " P", 3); fmt_int(b + str_len(b), tracker_ui.phrase + 1);
+    cv_text(0, 1, &FONT_S, b, C_HI);
+    cv_text(152, 1, &FONT_S, busy ? "READ ONLY" : "BANK EDIT", C_GRAY);
+    cv_blit(0, 0);
+    cv_begin(240, 18, C_BLACK);
+    cv_text(0, 0, &FONT_S, "ROW NOTE VEL INS FX", C_GRAY);
+    cv_blit(0, 20);
+    first = tracker_ui.row / 8u * 8u;
+    for (i = 0; i < 8u; i++) {
+        uint32_t row = first + i, j, on = 0, rat = 0;
+        uint16_t color = row == tracker_ui.row ? C_WHITE : C_HI;
+        const step_t *st = p ? &p->step[row] : 0;
+        cv_begin(240, 20, row == tracker_ui.row ? C_LINE : C_BLACK);
+        fmt_int(b, row); cv_text(0, 1, &FONT_S, b, color);
+        if (p && row < (uint32_t)p->length) {
+            if (is_drum(TSEL)) {
+                const dstep_t *d = &p->dstep[row];
+                on = (d->on[v / 8u] >> (v % 8u)) & 1u;
+                str_cpy(b, on ? "HIT" : "---", sizeof b);
+                rat = (d->rat[v / 4u] >> (2u * (v % 4u))) & 3u;
+            } else {
+                on = st->time == ST_NOTE && v < st->n && v < 4u;
+                if (on) note_name(b, st->note[v]);
+                else str_cpy(b, st->time == ST_TIE ? "===" : "---", sizeof b);
+                rat = (st->rat >> (2u * v)) & 3u;
+            }
+            cv_text(32, 1, &FONT_S, b, color);
+            if (!on) str_cpy(b, "---", sizeof b);
+            else if (is_drum(TSEL)) {
+                uint32_t level = (p->dstep[row].lvl[v / 4u] >> (2u * (v % 4u))) & 3u;
+                fmt_int(b, lvl_vel(level, 96));
+            } else fmt_int(b, lvl_vel((st->lvl >> (2u * v)) & 3u,
+                                      st->flags & SF_ACCENT ? 127 : st->vel ? st->vel : 96));
+            cv_text(72, 1, &FONT_S, b, color);
+            /* No per-row instrument exists: T1..T3 are live track sounds,
+             * D01..D16 are native drum lanes, never invented preset IDs. */
+            str_cpy(b, is_drum(TSEL) ? "D" : "T", sizeof b);
+            fmt_int(b + 1, is_drum(TSEL) ? v + 1 : song.sel + 1);
+            cv_text(104, 1, &FONT_S, b, C_GRAY);
+            str_cpy(b, "........", sizeof b);
+            if (!is_drum(TSEL)) {
+                if (st->flags & SF_ACCENT) b[0] = 'A';
+                if (st->flags & SF_SLIDE) b[1] = 'S';
+                if (st->flags & SF_CONT(v)) b[6] = 'C';
+                if (st->flags & SF_LEG) b[7] = 'G';
+            }
+            if (on && rat) b[2] = (char)('1' + rat);
+            if (p->micro[row]) b[3] = 'M';
+            if ((p->fill[row / 4u] >> (2u * (row % 4u))) & 3u) b[4] = 'F';
+            for (j = 0; j < NLOCK; j++) if (p->lock[j].step == row) b[5] = 'L';
+            cv_text(136, 1, &FONT_S, b, C_GRAY);
+        }
+        cv_blit(0, 38u + i * 20u);
+    }
+    cv_begin(240, 18, C_BLACK);
+    if (!p) str_cpy(b, "EMPTY: SEQ CAPTURES LIVE", sizeof b);
+    else {
+        str_cpy(b, "K3 VOICE ", sizeof b); fmt_int(b + 9, v + 1);
+        str_cpy(b + str_len(b), "  K4 MICRO ", 12);
+        fmt_int(b + str_len(b), p->micro[tracker_ui.row]);
+    }
+    cv_text(0, 0, &FONT_S, b, C_GRAY); cv_blit(0, 198);
+    cv_begin(240, 24, C_BLACK);
+    cv_text(0, 4, &FONT_S, "HOME:EXIT SEQ:CAP OCT+:LOAD", C_GRAY);
+    cv_blit(0, 216);
+}
+#endif
