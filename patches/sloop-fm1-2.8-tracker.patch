diff --git a/tests/tracker_phrase_test.c b/tests/tracker_phrase_test.c
new file mode 100644
index 0000000..b3daaf4
--- /dev/null
+++ b/tests/tracker_phrase_test.c
@@ -0,0 +1,174 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* FM-Tracker integration test through SLOOP's real mix_block/events_block/seq_tick path. */
+#define main hostsim_main
+#include "hostsim.c"
+#undef main
+#define PROJ_HOST 1
+static uint32_t trk_def_engine(uint32_t i) { return i < NPART ? i : 0u; }
+#include "../firmware/src/project.c"
+
+#include <assert.h>
+#include <stdio.h>
+
+static uint32_t transport_row(void)
+{
+    return clk_beat * 4u + (clk_pos * 4u) / BEAT_U;
+}
+
+static void play_to_row(uint32_t row)
+{
+    while (transport_row() < row)
+        run_block();
+    run_block(); /* process that row through mix_block -> events_block -> seq_tick */
+}
+
+static void locks_clear_test(plock_t *locks)
+{
+    uint32_t i;
+    for (i = 0; i < NLOCK; i++) {
+        locks[i].step = LOCK_FREE;
+        locks[i].param = 0;
+        locks[i].val = 0;
+    }
+}
+
+static int run_phrase_path(void)
+{
+    project_t scene;
+    step_t lead_a[NSTEP], lead_b[NSTEP], lead_c[NSTEP], second[NSTEP];
+    dstep_t drums_phrase[NSTEP];
+    int8_t micro[NSTEP];
+    uint8_t fill[NSTEP / 4u];
+    plock_t locks[NLOCK];
+    const fm_tracker_entry_t lead_chain[] = {
+        {0, 4, 1, 0}, {1, 4, 1, 0}, {2, 4, 1, 0}
+    };
+    const fm_tracker_entry_t second_chain[] = {{0, 2, 1, 12}, {1, 2, 1, 0}};
+    const fm_tracker_entry_t drum_chain[] = {{0, 4, 1, 0}};
+    uint32_t i;
+    int ok = 1;
+
+    memset(fm_tracker_phrase_bank, 0, sizeof fm_tracker_phrase_bank);
+    memset(fm_tracker_phrase_valid, 0, sizeof fm_tracker_phrase_valid);
+    host_tracks_init();
+    memset(&drums, 0, sizeof drums);
+    drums.set = -2;
+    tracker_init();
+    song.g[G_BPM] = 120;
+    song.playing = 0;
+    seq_reset_tracks(0);
+
+    memset(lead_a, 0, sizeof lead_a);
+    memset(lead_b, 0, sizeof lead_b);
+    memset(lead_c, 0, sizeof lead_c);
+    memset(second, 0, sizeof second);
+    memset(drums_phrase, 0, sizeof drums_phrase);
+    memset(micro, 0, sizeof micro);
+    memset(fill, 0, sizeof fill);
+    locks_clear_test(locks);
+    micro[0] = (int8_t)(MICRO_MAX + 1);
+    if (fm_tracker_phrase_store(0, 3, lead_a, micro, fill, locks, 4, 2, 0, 64))
+        return 1;
+    micro[0] = 0;
+
+    lead_a[0].note[0] = 60; lead_a[0].note[1] = 64;
+    lead_a[0].n = 2; lead_a[0].time = ST_NOTE;
+    lead_a[0].flags = SF_ACCENT; lead_a[0].vel = 110;
+    lead_a[0].lvl = LV_GHOST | (LV_HARD << 2);
+    lead_a[0].rat = 1u; /* note 0 x2; note 1 x1 */
+    for (i = 1; i < 4u; i++) lead_a[i].time = ST_TIE;
+    locks[0].step = 3; locks[0].param = P_LEVEL; locks[0].val = 90;
+    micro[0] = -8;
+    for (i = 0; i < 4u; i++) lead_b[i].time = ST_TIE;
+    lead_c[0].time = ST_REST;
+    second[0].note[0] = 72; second[0].n = 1; second[0].time = ST_NOTE;
+    second[1].time = ST_REST;
+    drums_phrase[0].on[0] = 1u;
+    drums_phrase[0].lvl[0] = LV_HARD;
+    drums_phrase[0].rat[0] = 1u;
+
+    ok &= fm_tracker_phrase_store(0, 0, lead_a, micro, fill, locks, 4, 2, 0, 64);
+    locks_clear_test(locks);
+    ok &= fm_tracker_phrase_store(0, 1, lead_b, micro, fill, locks, 4, 2, 0, 64);
+    ok &= fm_tracker_phrase_store(0, 2, lead_c, micro, fill, locks, 4, 2, 0, 64);
+    ok &= fm_tracker_phrase_store(1, 0, second, micro, fill, locks, 4, 2, 0, 64);
+    ok &= fm_tracker_phrase_store(1, 1, second, micro, fill, locks, 4, 2, 0, 64);
+    ok &= fm_tracker_phrase_store(3, 0, (const step_t *)drums_phrase,
+                                  micro, fill, locks, 4, 2, 0, 64);
+    if (!ok) return 1;
+
+    trk[0].p[P_LEVEL] = 64;
+    ok &= fm_tracker_sloop_set_chain(&fm_tracker_sloop, 0, lead_chain, 3, 0);
+    ok &= fm_tracker_sloop_set_chain(&fm_tracker_sloop, 1, second_chain, 2, 0);
+    ok &= fm_tracker_sloop_set_chain(&fm_tracker_sloop, 3, drum_chain, 1, 0);
+    ok &= fm_tracker_sloop_start_chain(&fm_tracker_sloop, 0, 0);
+    ok &= fm_tracker_sloop_start_chain(&fm_tracker_sloop, 1, 0);
+    ok &= fm_tracker_sloop_start_chain(&fm_tracker_sloop, 3, 0);
+    run_block();
+    ok &= fm_tracker_sloop.active_phrase[0] == 0;
+    ok &= trk[0].seq_idx == 0u && trk[0].seq_n == 2u;
+    ok &= trk[0].seq_notes[0] == 60u && trk[0].seq_notes[1] == 64u;
+    ok &= memcmp(trk[0].step, lead_a, sizeof lead_a) == 0;
+    ok &= trk[1].seq_n == 1u && trk[1].seq_notes[0] == 84u; /* chain transpose uses a bank copy */
+    ok &= memcmp(trk[TRK_DRUM].dstep, drums_phrase, sizeof drums_phrase) == 0;
+    ok &= trk[TRK_DRUM].seq_idx == 0u;
+
+    play_to_row(2);
+    ok &= fm_tracker_sloop.active_phrase[1] == 1; /* this track advances while track 0 stays on A */
+    ok &= fm_tracker_sloop.active_phrase[0] == 0;
+    play_to_row(3);
+    ok &= trk[0].p[P_LEVEL] == 90; /* SLOOP's native lock_step applied the lock */
+    play_to_row(4);
+    ok &= fm_tracker_sloop.active_phrase[0] == 1;
+    ok &= trk[0].seq_idx == 0u && trk[0].seq_n == 2u; /* TIE at new phrase start keeps both notes */
+    ok &= trk[0].p[P_LEVEL] == 64 && trk[0].lk_n == 0u; /* transition restored owned lock */
+    proj_capture(&scene);
+    scene.t[0].step[0].time = ST_REST;
+    scene.t[0].step[0].n = 0u;
+    scene.sum = proj_sum(&scene);
+    proj_apply(&scene, 0);
+    ok &= trk[0].step[0].time == ST_TIE; /* whole-scene load cannot replace an active phrase */
+    play_to_row(8);
+    ok &= fm_tracker_sloop.active_phrase[0] == 2;
+    ok &= trk[0].seq_n == 0u; /* native REST releases previous phrase notes */
+    ok &= fm_tracker_sloop.active_phrase[1] == FM_TRACKER_NO_PHRASE;
+    ok &= fm_tracker_sloop.active_phrase[3] == 0;
+    return ok ? 0 : 1;
+}
+
+static int run_scene_isolation(void)
+{
+    uint32_t before;
+    step_t *scene_step;
+    memset(&proj_slot[0], 0, sizeof proj_slot[0]);
+    memset(&proj_slot[1], 0, sizeof proj_slot[1]);
+    proj_capture(&proj_slot[0]);
+    proj_slot[0].t[0].step[7].n = 3;
+    proj_slot[0].t[0].step[7].note[0] = 48;
+    proj_slot[0].t[0].step[7].note[1] = 55;
+    proj_slot[0].t[0].step[7].note[2] = 60;
+    proj_slot[0].t[0].step[7].time = ST_NOTE;
+    proj_slot[0].t[0].mf[7] = (uint8_t)(0x38u | (FC_FILL << 6));
+    proj_slot[0].t[0].lock[0] = (plock_t){7, P_LEVEL, 88};
+    proj_slot[0].sum = proj_sum(&proj_slot[0]);
+    before = proj_slot[0].sum;
+    if (!fm_tracker_phrase_import_scene(0, 3, 0)) return 1;
+    scene_step = &fm_tracker_phrase_bank[0][3].step[7];
+    return proj_slot[0].sum == before && proj_slot[1].magic == 0u &&
+           scene_step->n == 3u && scene_step->note[0] == 48u &&
+           scene_step->note[1] == 55u && scene_step->note[2] == 60u &&
+           fm_tracker_phrase_bank[0][3].micro[7] == -8 &&
+           ((fm_tracker_phrase_bank[0][3].fill[1] >> 6) & 3u) == FC_FILL &&
+           fm_tracker_phrase_bank[0][3].lock[0].val == 88;
+}
+
+int main(void)
+{
+    int fails = 0;
+    fails += run_phrase_path();
+    fails += run_scene_isolation();
+    printf("tracker_phrase_test: %s (phrase bank %u bytes)\n",
+           fails ? "FAIL" : "ok",
+           (unsigned)sizeof fm_tracker_phrase_bank + sizeof fm_tracker_phrase_valid);
+    return fails;
+}
