+static void copy_bytes(void *dst, const void *src, size_t count)
+{
+    unsigned char *out = (unsigned char *)dst;
+    const unsigned char *in = (const unsigned char *)src;
+    size_t i;
+    for (i = 0u; i < count; ++i)
+        out[i] = in[i];
+}
+
+static void change_to(fm_tracker_track_t *track, int16_t phrase,
+                      int8_t transpose, uint32_t row,
+                      fm_tracker_change_t *change)
+{
+    track->active = phrase >= 0;
+    track->phrase = track->active ? phrase : FM_TRACKER_NO_PHRASE;
+    track->transpose = track->active ? transpose : 0;
+    track->entry_start_row = row;
+    change->changed = 1u;
+    change->stopped = (uint8_t)!track->active;
+    change->phrase = track->phrase;
+    change->transpose = track->transpose;
+}
+
+void fm_tracker_init(fm_tracker_t *tracker)
+{
+    uint8_t i;
+    if (tracker != NULL) {
+        clear_bytes(tracker, sizeof(*tracker));
+        for (i = 0u; i < FM_TRACKER_TRACKS; ++i)
+            tracker->tracks[i].phrase = FM_TRACKER_NO_PHRASE;
+    }
+}
+
+void fm_tracker_transport_reset(fm_tracker_t *tracker)
+{
+    uint8_t i;
+    if (tracker == NULL)
+        return;
+    for (i = 0u; i < FM_TRACKER_TRACKS; ++i) {
+        fm_tracker_track_t *state = &tracker->tracks[i];
+        clear_bytes(&state->chain_running,
+                    sizeof(*state) - offsetof(fm_tracker_track_t, chain_running));
+        state->phrase = FM_TRACKER_NO_PHRASE;
+    }
+    tracker->last_row = 0u;
+    tracker->have_row = 0u;
+}
+
+int fm_tracker_set_chain(fm_tracker_t *tracker, uint8_t track,
+                         const fm_tracker_entry_t *entries, uint8_t count,
+                         uint8_t loop)
+{
+    uint8_t i;
+    if (tracker == NULL || track >= FM_TRACKER_TRACKS ||
+        count > FM_TRACKER_CHAIN_ENTRIES || (count != 0u && entries == NULL) ||
+        loop > 1u)
+        return 0;
+    for (i = 0u; i < count; ++i)
+        if (entries[i].phrase < 0 || entries[i].rows == 0u ||
+            entries[i].repeats == 0u)
+            return 0;
+    clear_bytes(&tracker->tracks[track].chain,
+                sizeof(tracker->tracks[track].chain));
+    if (count != 0u)
+        copy_bytes(tracker->tracks[track].chain.entries, entries,
+                   (size_t)count * sizeof(*entries));
+    tracker->tracks[track].chain.count = count;
+    tracker->tracks[track].chain.loop = loop;
+    tracker->tracks[track].chain_running = 0u;
+    tracker->tracks[track].chain_start_pending = 0u;
+    return 1;
+}
+
+int fm_tracker_start_chain(fm_tracker_t *tracker, uint8_t track,
+                           uint32_t at_row)
+{
+    fm_tracker_track_t *state;
+    if (tracker == NULL || track >= FM_TRACKER_TRACKS)
+        return 0;
+    state = &tracker->tracks[track];
+    if (state->chain.count == 0u ||
+        (tracker->have_row && at_row <= tracker->last_row))
+        return 0;
+    state->chain_running = 1u;
+    state->chain_start_pending = 1u;
+    state->chain_start_row = at_row;
+    state->position = 0u;
+    state->repeat = 0u;
+    state->launch.pending = 0u;
+    return 1;
+}
+
+int fm_tracker_stop_track(fm_tracker_t *tracker, uint8_t track,
+                          uint32_t at_row)
+{
+    fm_tracker_track_t *state;
+    if (tracker == NULL || track >= FM_TRACKER_TRACKS)
+        return 0;
+    if (tracker->have_row && at_row <= tracker->last_row)
+        return 0;
+    state = &tracker->tracks[track];
+    state->launch.pending = 1u;
+    state->launch.phrase = FM_TRACKER_NO_PHRASE;
+    state->launch.transpose = 0;
+    state->launch.at_row = at_row;
+    return 1;
+}
+
+int fm_tracker_queue_launch(fm_tracker_t *tracker, uint8_t track,
+                            int16_t phrase, int8_t transpose,
+                            uint32_t at_row)
+{
+    fm_tracker_track_t *state;
+    if (tracker == NULL || track >= FM_TRACKER_TRACKS || phrase < -1 ||
+        (tracker->have_row && at_row <= tracker->last_row))
+        return 0;
+    state = &tracker->tracks[track];
+    state->launch.pending = 1u;
+    state->launch.phrase = phrase;
+    state->launch.at_row = at_row;
+    state->launch.transpose = transpose;
+    return 1;
+}
+
+int fm_tracker_quantize_row(uint32_t requested_row, fm_tracker_quantum_t quantum,
+                            uint16_t rows_per_beat, uint16_t beats_per_bar,
+                            uint16_t phrase_rows, uint32_t *scheduled_row)
+{
+    uint32_t grid;
+    uint32_t remainder;
+    if (scheduled_row == NULL || rows_per_beat == 0u || beats_per_bar == 0u ||
+        phrase_rows == 0u)
+        return 0;
+    switch (quantum) {
+    case FM_TRACKER_ROW:
+        grid = 1u;
+        break;
+    case FM_TRACKER_BEAT:
+        grid = rows_per_beat;
+        break;
+    case FM_TRACKER_BAR:
+        grid = (uint32_t)rows_per_beat * beats_per_bar;
+        break;
+    case FM_TRACKER_PHRASE:
+        grid = phrase_rows;
+        break;
+    default:
+        return 0;
+    }
+    remainder = requested_row % grid;
+    if (remainder != 0u) {
+        uint32_t addition = grid - remainder;
+        if (UINT32_MAX - requested_row < addition)
+            return 0;
+        requested_row += addition;
+    }
+    *scheduled_row = requested_row;
+    return 1;
+}
+
+int fm_tracker_queue_quantized(fm_tracker_t *tracker, uint8_t track,
+                               int16_t phrase, int8_t transpose,
+                               uint32_t requested_row, fm_tracker_quantum_t quantum,
+                               uint16_t rows_per_beat, uint16_t beats_per_bar,
+                               uint16_t phrase_rows)
+{
+    uint32_t scheduled;
+    if (!fm_tracker_quantize_row(requested_row, quantum, rows_per_beat,
+                                 beats_per_bar, phrase_rows, &scheduled))
+        return 0;
+    return fm_tracker_queue_launch(tracker, track, phrase, transpose, scheduled);
+}
+
+static void chain_advance(fm_tracker_track_t *state, uint32_t row,
+                          fm_tracker_change_t *change)
+{
+    fm_tracker_chain_t *chain = &state->chain;
+    fm_tracker_entry_t *entry;
+    if (state->chain_start_pending) {
+        if (state->chain_start_row > row)
+            return;
+        entry = &chain->entries[0];
+        state->chain_start_pending = 0u;
+        state->position = 0u;
+        state->repeat = 0u;
+        change_to(state, entry->phrase, entry->transpose, row, change);
+        return;
+    }
+    if (!state->chain_running || state->position >= chain->count)
+        return;
+    entry = &chain->entries[state->position];
+    if (row - state->entry_start_row < entry->rows)
+        return;
+    if (++state->repeat < entry->repeats) {
+        change_to(state, entry->phrase, entry->transpose, row, change);
+        return;
+    }
+    state->repeat = 0u;
+    if (++state->position >= chain->count) {
+        if (!chain->loop) {
+            state->chain_running = 0u;
+            change_to(state, FM_TRACKER_NO_PHRASE, 0, row, change);
+            return;
+        }
+        state->position = 0u;
+    }
+    entry = &chain->entries[state->position];
+    change_to(state, entry->phrase, entry->transpose, row, change);
+}
+
+int fm_tracker_advance(fm_tracker_t *tracker, uint32_t transport_row,
+                       fm_tracker_change_t changes[FM_TRACKER_TRACKS])
+{
+    uint8_t i;
+    if (tracker == NULL || changes == NULL)
+        return 0;
+    if (tracker->have_row &&
+        (transport_row < tracker->last_row ||
+         (tracker->last_row != UINT32_MAX && transport_row > tracker->last_row + 1u)))
+        return 0;
+    clear_bytes(changes, sizeof(*changes) * FM_TRACKER_TRACKS);
+    tracker->last_row = transport_row;
+    tracker->have_row = 1u;
+    for (i = 0u; i < FM_TRACKER_TRACKS; ++i) {
+        fm_tracker_track_t *state = &tracker->tracks[i];
+        fm_tracker_change_t *change = &changes[i];
+        if (state->launch.pending && state->launch.at_row <= transport_row) {
+            int16_t phrase = state->launch.phrase;
+            int8_t transpose = state->launch.transpose;
+            state->launch.pending = 0u;
+            state->chain_running = 0u;
+            state->chain_start_pending = 0u;
+            change_to(state, phrase, transpose, transport_row, change);
+        } else {
+            chain_advance(state, transport_row, change);
+        }
+    }
+    return 1;
+}
diff --git a/firmware/src/tracker_chain.h b/firmware/src/tracker_chain.h
new file mode 100644
index 0000000..7cbcee6
--- /dev/null
+++ b/firmware/src/tracker_chain.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * FM-Tracker bounded chain/launch state for host verification and SLOOP porting.
+ * This module never advances the transport and has no audio or engine calls.
+ */
+#ifndef FM_TRACKER_CHAIN_H
+#define FM_TRACKER_CHAIN_H
+
+#include <stdint.h>
+
+#define FM_TRACKER_TRACKS 4u
+#define FM_TRACKER_CHAIN_ENTRIES 16u
+#define FM_TRACKER_NO_PHRASE INT16_C(-1)
+
+typedef struct {
+    int16_t phrase;
+    uint16_t rows;
+    uint8_t repeats;
+    int8_t transpose;
+} fm_tracker_entry_t;
+
+typedef struct {
+    uint8_t count;
+    uint8_t loop;
+    fm_tracker_entry_t entries[FM_TRACKER_CHAIN_ENTRIES];
+} fm_tracker_chain_t;
+
+typedef struct {
+    int16_t phrase;
+    int8_t transpose;
+    uint32_t at_row;
+    uint8_t pending;
+} fm_tracker_launch_t;
+
+typedef struct {
+    fm_tracker_chain_t chain;
+    uint8_t chain_running;
+    uint8_t chain_start_pending;
+    uint32_t chain_start_row;
+    uint8_t position;
+    uint8_t repeat;
+    uint8_t active;
+    int16_t phrase;
+    int8_t transpose;
+    uint32_t entry_start_row;
+    fm_tracker_launch_t launch;
+} fm_tracker_track_t;
+
+typedef struct {
+    fm_tracker_track_t tracks[FM_TRACKER_TRACKS];
+    uint32_t last_row;
+    uint8_t have_row;
+} fm_tracker_t;
+
+typedef struct {
+    uint8_t changed;
+    uint8_t stopped;
+    int16_t phrase;
+    int8_t transpose;
+} fm_tracker_change_t;
+
+typedef enum {
+    FM_TRACKER_ROW = 0,
+    FM_TRACKER_BEAT = 1,
+    FM_TRACKER_BAR = 2,
+    FM_TRACKER_PHRASE = 3
+} fm_tracker_quantum_t;
+
+void fm_tracker_init(fm_tracker_t *tracker);
+/* Clear active chain/launch runtime while preserving configured chains. */
+void fm_tracker_transport_reset(fm_tracker_t *tracker);
+int fm_tracker_set_chain(fm_tracker_t *tracker, uint8_t track,
+                         const fm_tracker_entry_t *entries, uint8_t count,
+                         uint8_t loop);
+int fm_tracker_start_chain(fm_tracker_t *tracker, uint8_t track,
+                           uint32_t at_row);
+int fm_tracker_stop_track(fm_tracker_t *tracker, uint8_t track,
+                          uint32_t at_row);
+int fm_tracker_queue_launch(fm_tracker_t *tracker, uint8_t track,
+                            int16_t phrase, int8_t transpose,
+                            uint32_t at_row);
+int fm_tracker_quantize_row(uint32_t requested_row, fm_tracker_quantum_t quantum,
+                            uint16_t rows_per_beat, uint16_t beats_per_bar,
+                            uint16_t phrase_rows, uint32_t *scheduled_row);
+int fm_tracker_queue_quantized(fm_tracker_t *tracker, uint8_t track,
+                               int16_t phrase, int8_t transpose,
+                               uint32_t requested_row, fm_tracker_quantum_t quantum,
+                               uint16_t rows_per_beat, uint16_t beats_per_bar,
+                               uint16_t phrase_rows);
+/* Call once per advancing row, detected from SLOOP's existing transport in its
+ * event callback. Rows must stay monotonic and consecutive; no clock is owned
+ * or advanced here. */
+int fm_tracker_advance(fm_tracker_t *tracker, uint32_t transport_row,
+                       fm_tracker_change_t changes[FM_TRACKER_TRACKS]);
+
+#endif
diff --git a/firmware/src/tracker_sloop_adapter.c b/firmware/src/tracker_sloop_adapter.c
new file mode 100644
index 0000000..b2f3c1f
--- /dev/null
+++ b/firmware/src/tracker_sloop_adapter.c
@@ -0,0 +1,164 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include "tracker_sloop_adapter.h"
+
+#include <stddef.h>
+
+static int control_lock(fm_tracker_sloop_t *adapter, uint32_t *token)
+{
+    if (adapter->ops.control_lock == NULL || adapter->ops.control_unlock == NULL)
+        return 0;
+    *token = adapter->ops.control_lock(adapter->user);
+    return 1;
+}
+
+static void control_unlock(fm_tracker_sloop_t *adapter, uint32_t token)
+{
+    adapter->ops.control_unlock(adapter->user, token);
+}
+
+void fm_tracker_sloop_init(fm_tracker_sloop_t *adapter,
+                           const fm_tracker_sloop_ops_t *ops, void *user)
+{
+    uint8_t i;
+    if (adapter == NULL)
+        return;
+    fm_tracker_init(&adapter->scheduler);
+    adapter->ops.control_lock = NULL;
+    adapter->ops.control_unlock = NULL;
+    adapter->ops.phrase_valid = NULL;
+    adapter->ops.transition = NULL;
+    adapter->user = NULL;
+    for (i = 0; i < FM_TRACKER_TRACKS; ++i) {
+        adapter->active_phrase[i] = FM_TRACKER_NO_PHRASE;
+        adapter->active_transpose[i] = 0;
+    }
+    if (ops != NULL)
+        adapter->ops = *ops;
+    adapter->user = user;
+}
+
+int fm_tracker_sloop_set_chain(fm_tracker_sloop_t *adapter, uint8_t track,
+                               const fm_tracker_entry_t *entries,
+                               uint8_t count, uint8_t loop)
+{
+    uint32_t token;
+    int result;
+    uint8_t i;
+    if (adapter == NULL || !control_lock(adapter, &token))
+        return 0;
+    result = 1;
+    if (track >= FM_TRACKER_TRACKS || count > FM_TRACKER_CHAIN_ENTRIES ||
+        (count != 0u && entries == NULL))
+        result = 0;
+    if (result && adapter->ops.phrase_valid != NULL)
+        for (i = 0; i < count; ++i)
+            if (!adapter->ops.phrase_valid(adapter->user, track, entries[i].phrase))
+                result = 0;
+    if (result)
+        result = fm_tracker_set_chain(&adapter->scheduler, track, entries,
+                                      count, loop);
+    control_unlock(adapter, token);
+    return result;
+}
+
+int fm_tracker_sloop_start_chain(fm_tracker_sloop_t *adapter, uint8_t track,
+                                 uint32_t at_row)
+{
+    uint32_t token;
+    int result;
+    if (adapter == NULL || !control_lock(adapter, &token))
+        return 0;
+    result = fm_tracker_start_chain(&adapter->scheduler, track, at_row);
+    control_unlock(adapter, token);
+    return result;
+}
+
+int fm_tracker_sloop_stop_track(fm_tracker_sloop_t *adapter, uint8_t track,
+                                uint32_t at_row)
+{
+    uint32_t token;
+    int result;
+    if (adapter == NULL || !control_lock(adapter, &token))
+        return 0;
+    result = fm_tracker_stop_track(&adapter->scheduler, track, at_row);
+    control_unlock(adapter, token);
+    return result;
+}
+
+int fm_tracker_sloop_queue_launch(fm_tracker_sloop_t *adapter, uint8_t track,
+                                  int16_t phrase, int8_t transpose,
+                                  uint32_t at_row)
+{
+    uint32_t token;
+    int result;
+    if (adapter == NULL || !control_lock(adapter, &token))
+        return 0;
+    result = adapter->ops.phrase_valid == NULL || phrase < 0 ||
+             adapter->ops.phrase_valid(adapter->user, track, phrase);
+    if (result)
+        result = fm_tracker_queue_launch(&adapter->scheduler, track, phrase,
+                                         transpose, at_row);
+    control_unlock(adapter, token);
+    return result;
+}
+
+int fm_tracker_sloop_queue_quantized(fm_tracker_sloop_t *adapter,
+                                     uint8_t track, int16_t phrase,
+                                     int8_t transpose, uint32_t requested_row,
+                                     fm_tracker_quantum_t quantum,
+                                     uint16_t rows_per_beat,
+                                     uint16_t beats_per_bar,
+                                     uint16_t phrase_rows)
+{
+    uint32_t token;
+    int result;
+    if (adapter == NULL || !control_lock(adapter, &token))
+        return 0;
+    result = adapter->ops.phrase_valid == NULL || phrase < 0 ||
+             adapter->ops.phrase_valid(adapter->user, track, phrase);
+    if (result)
+        result = fm_tracker_queue_quantized(
+            &adapter->scheduler, track, phrase, transpose, requested_row,
+            quantum, rows_per_beat, beats_per_bar, phrase_rows);
+    control_unlock(adapter, token);
+    return result;
+}
+
+void fm_tracker_sloop_transport_reset(fm_tracker_sloop_t *adapter)
+{
+    uint8_t i;
+    if (adapter == NULL)
+        return;
+    for (i = 0u; i < FM_TRACKER_TRACKS; ++i) {
+        if (adapter->active_phrase[i] >= 0 && adapter->ops.transition != NULL)
+            adapter->ops.transition(adapter->user, i, adapter->active_phrase[i],
+                                    adapter->active_transpose[i],
+                                    FM_TRACKER_NO_PHRASE, 0, 1u);
+        adapter->active_phrase[i] = FM_TRACKER_NO_PHRASE;
+        adapter->active_transpose[i] = 0;
+    }
+    fm_tracker_transport_reset(&adapter->scheduler);
+}
+
+int fm_tracker_sloop_row(fm_tracker_sloop_t *adapter, uint32_t transport_row)
+{
+    fm_tracker_change_t changes[FM_TRACKER_TRACKS];
+    uint8_t i;
+    if (adapter == NULL || !fm_tracker_advance(&adapter->scheduler,
+                                                transport_row, changes))
+        return 0;
+    if (adapter->ops.transition == NULL)
+        return 1;
+    for (i = 0; i < FM_TRACKER_TRACKS; ++i) {
+        const fm_tracker_change_t *c = &changes[i];
+        if (c->changed) {
+            adapter->ops.transition(adapter->user, i,
+                                     adapter->active_phrase[i],
+                                     adapter->active_transpose[i], c->phrase,
+                                     c->transpose, c->stopped);
+            adapter->active_phrase[i] = c->phrase;
+            adapter->active_transpose[i] = c->transpose;
+        }
+    }
+    return 1;
+}
diff --git a/firmware/src/tracker_sloop_adapter.h b/firmware/src/tracker_sloop_adapter.h
new file mode 100644
index 0000000..55010fe
--- /dev/null
+++ b/firmware/src/tracker_sloop_adapter.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * FM-Tracker boundary adapter for SLOOP's existing audio-block sequencer.
+ * The caller supplies SLOOP's transport row; this module never owns a clock.
+ */
+#ifndef FM_TRACKER_SLOOP_ADAPTER_H
+#define FM_TRACKER_SLOOP_ADAPTER_H
+
+#include "tracker_chain.h"
+
+typedef struct {
+    /* Required for control-thread changes while SLOOP audio is active. Map to
+     * SLOOP's IRQ save/restore pair; the row callback itself runs in that ISR. */
+    uint32_t (*control_lock)(void *user);
+    void (*control_unlock)(void *user, uint32_t token);
+    /* Optional bank validator. With no validator, phrase IDs are external. */
+    int (*phrase_valid)(void *user, uint8_t track, int16_t phrase);
+    /* Called in the audio-block context, before SLOOP advances that track's
+     * sequencer. Implementations must release/retain notes using SLOOP's own
+     * seq_release/trk_note_off semantics, restore locks, and select only this
+     * track's phrase. A stopped change has phrase == FM_TRACKER_NO_PHRASE. */
+    void (*transition)(void *user, uint8_t track, int16_t old_phrase,
+                       int8_t old_transpose, int16_t phrase,
+                       int8_t transpose, uint8_t stopped);
+} fm_tracker_sloop_ops_t;
+
+typedef struct {
+    fm_tracker_t scheduler;
+    fm_tracker_sloop_ops_t ops;
+    void *user;
+    int16_t active_phrase[FM_TRACKER_TRACKS];
+    int8_t active_transpose[FM_TRACKER_TRACKS];
+} fm_tracker_sloop_t;
+
+
+void fm_tracker_sloop_init(fm_tracker_sloop_t *adapter,
+                           const fm_tracker_sloop_ops_t *ops, void *user);
+int fm_tracker_sloop_set_chain(fm_tracker_sloop_t *adapter, uint8_t track,
+                               const fm_tracker_entry_t *entries,
+                               uint8_t count, uint8_t loop);
+int fm_tracker_sloop_start_chain(fm_tracker_sloop_t *adapter, uint8_t track,
+                                 uint32_t at_row);
+int fm_tracker_sloop_stop_track(fm_tracker_sloop_t *adapter, uint8_t track,
+                                uint32_t at_row);
+int fm_tracker_sloop_queue_launch(fm_tracker_sloop_t *adapter, uint8_t track,
+                                  int16_t phrase, int8_t transpose,
+                                  uint32_t at_row);
+int fm_tracker_sloop_queue_quantized(fm_tracker_sloop_t *adapter,
+                                     uint8_t track, int16_t phrase,
+                                     int8_t transpose, uint32_t requested_row,
+                                     fm_tracker_quantum_t quantum,
+                                     uint16_t rows_per_beat,
+                                     uint16_t beats_per_bar,
+                                     uint16_t phrase_rows);
+/* End all current phrase ownership and return to row zero while retaining the
+ * configured chains. SLOOP should call this on stop/restart clock reset. */
+void fm_tracker_sloop_transport_reset(fm_tracker_sloop_t *adapter);
+/* Invoke once per SLOOP transport row from its existing events_block path.
+ * Returns 1 when processed, 0 on an invalid/discontinuous row. */
+int fm_tracker_sloop_row(fm_tracker_sloop_t *adapter, uint32_t transport_row);
+
+#endif
